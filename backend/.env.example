APP_ENV=development
APP_NAME=DUX Vault Backend
API_PREFIX=/api
LOG_LEVEL=INFO

DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=your-password

DOC_ROOT_CANONICAL=e:\DATA1\IT\IDMFiles\infor\infor
DOC_ROOT_LOCAL=/mnt/idm/infor

# Active Directory. Comma-separate two or more domain controllers for failover.
LDAP_SERVERS=dc1.corp.local,dc2.corp.local
LDAP_PORT=636
LDAP_USE_SSL=true
# PEM bundle for the CA that issued the domain controller certificates. Required
# when LDAP_USE_SSL is true - the password is sent on a simple bind, so the server
# has to be validated. Active Directory publishes the CA in the directory itself;
# generate the bundle with:
#   PYTHONPATH=. python scripts/fetch_ca_cert.py --user DOMAIN\\yourname
# Path is relative to the backend working directory, as with STATIC_DIR.
LDAP_CA_CERT_FILE=certs/corp-ca.pem
LDAP_BASE_DN=DC=corp,DC=local
LDAP_DOMAIN_NETBIOS=CORP
LDAP_DOMAIN_DNS=corp.local
LDAP_GROUP_GENERAL=DUX_Vault_General
LDAP_GROUP_CONFIDENTIAL=DUX_Vault_Confidential
# Optional. Only needed if ordinary users may not read group membership.
# NETBIOS form, e.g. CORP\svc-account. Setting this routes the group lookup for
# every user through the service account instead of their own connection.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_TIMEOUT_SECONDS=10

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_SECRET=replace-with-long-random-string
SESSION_COOKIE_NAME=duxvault_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# 8 hours. Entitlements are resolved at sign-in and cached for the session lifetime,
# so an Active Directory group change takes effect at the user's next sign-in.
SESSION_MAX_AGE_SECONDS=28800

AUTH_BYPASS_ENABLED=false
AUTH_BYPASS_USERNAME=local.dev
AUTH_BYPASS_DISPLAY_NAME=Local Developer
AUTH_BYPASS_EMAIL=local.dev@duxvault.local
AUTH_BYPASS_GROUPS=

STATIC_DIR=static
